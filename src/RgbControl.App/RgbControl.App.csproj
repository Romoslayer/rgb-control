<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon); WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RgbControl</AssemblyName>
    <ApplicationIcon>Assets\RgbControl.ico</ApplicationIcon>
    <!-- ThemeMode (Windows 11 Fluent styling) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WinForms/WPF name clashes (Application, Button, Color, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\RgbControl.ico" />
    <Resource Include="Assets\RgbControl-off.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RgbControl.Core\RgbControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

</Project>
