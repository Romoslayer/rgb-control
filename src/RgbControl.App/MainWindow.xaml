<Window x:Class="RgbControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RgbControl.App"
        Title="RGB Control" Width="600" Height="880" MinWidth="480" MinHeight="500"
        Icon="Assets/RgbControl.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Shared body of a lighting card: effect, color, brightness and speed. -->
        <DataTemplate x:Key="LightingBody" DataType="{x:Type local:DeviceLightingViewModel}">
            <StackPanel>
                <Grid Margin="0,16,0,0" IsEnabled="{Binding Enabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Effect" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                              DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="200" />
                </Grid>

                <Grid Margin="0,12,0,0" Visibility="{Binding ShowSpeed, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Speed" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}"
                              IsEnabled="{Binding CanChangeSpeed}"
                              DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="200" />
                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="Pick an animated effect to change speed.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanChangeSpeed}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Visibility="{Binding ShowColor, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Column="1" Minimum="5" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding Brightness}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0}%}"
                                   Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" Margin="0" />
                    </Grid>

                    <local:ColorEditor Margin="0,16,0,0" Hex="{Binding Color}" />
                </StackPanel>

                <TextBlock Margin="0,12,0,0" Text="This effect cycles through colors by itself, so color and brightness don't apply.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Enabled}" Value="True" />
                                        <Condition Binding="{Binding Mode.UsesColor}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="RGB Control" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Lighting is applied by the background service, even before you sign in."
                           Style="{StaticResource Hint}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Right"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#E0A030" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServiceRunning}" Value="True">
                                            <Setter Property="Fill" Value="#3CB371" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ServiceStatus}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <CheckBox Margin="0,10,0,0" HorizontalAlignment="Right" FontWeight="SemiBold"
                          IsChecked="{Binding LightingOn}" Content="Lighting on" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel Margin="0,0,0,12">

                <!-- Motherboard -->
                <Border Style="{StaticResource Card}" IsEnabled="{Binding LightingOn}">
                    <StackPanel DataContext="{Binding Motherboard}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Lighting.Enabled}" Content="On" />
                            <StackPanel>
                                <TextBlock Text="Motherboard" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Onboard lighting and RGB headers" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                        <ComboBox Margin="0,12,0,0" ItemsSource="{Binding Controllers}"
                                  SelectedValue="{Binding Controller}" SelectedValuePath="Kind" DisplayMemberPath="Label" />
                        <ContentControl Content="{Binding Lighting}" ContentTemplate="{StaticResource LightingBody}" />
                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding IncludeAddressableHeaders}"
                                  IsEnabled="{Binding Lighting.Enabled}"
                                  Content="Also apply to headers without custom settings" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" IsEnabled="{Binding LightingOn}">
                    <StackPanel>
                        <TextBlock Text="ARGB devices" Style="{StaticResource CardTitle}" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource Hint}"
                                   Text="For Kraken Core pump/fan lighting and GPUs connected by a 5V ARGB cable. These are header settings, not detected devices. Only configure headers your board has. Devices sharing a header share its effect." />
                        <ItemsControl ItemsSource="{Binding VisibleArgbHeaders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8,0,16">
                                        <TextBlock Text="{Binding HeaderLabel}" FontWeight="SemiBold" />
                                        <CheckBox Margin="0,8,0,0" Content="Use separate lighting settings"
                                                  IsChecked="{Binding UseCustomSettings}" />
                                        <StackPanel Visibility="{Binding UseCustomSettings, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Device label" Style="{StaticResource Hint}" Margin="0,10,0,4" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Margin="0,10,0,0" Content="Lighting on" IsChecked="{Binding Lighting.Enabled}" />
                                            <ContentControl Content="{Binding Lighting}" ContentTemplate="{StaticResource LightingBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Gpus}" IsEnabled="{Binding LightingOn}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Margin="0,4,0,8" Text="Experimental support — enable only on a PC with this card."
                                               Style="{StaticResource Hint}" />
                                    <CheckBox Content="Control this GPU" IsChecked="{Binding Managed}" />
                                    <StackPanel Visibility="{Binding Managed, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox Margin="0,12,0,0" Content="Use motherboard ARGB cable instead of direct control"
                                                  IsChecked="{Binding UseArgbCable}" />
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}"
                                                   Visibility="{Binding UseArgbCable, Converter={StaticResource BoolToVisibility}}"
                                                   Text="Connect the GPU's 5V ARGB cable and configure its header above. The app will request external sync. If direct communication is unavailable, enable external sync in TriXX or Keystone, then disable Control this GPU here; the header still works." />
                                        <StackPanel Visibility="{Binding UseDirect, Converter={StaticResource BoolToVisibility}}">
                                            <CheckBox Margin="0,12,0,0" Content="Lighting on" IsChecked="{Binding Lighting.Enabled}" />
                                            <ContentControl Content="{Binding Lighting}" ContentTemplate="{StaticResource LightingBody}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- RAM -->
                <Border Style="{StaticResource Card}" IsEnabled="{Binding LightingOn}">
                    <StackPanel>
                        <DockPanel DataContext="{Binding Ram}">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" Content="On" />
                            <StackPanel>
                                <TextBlock Text="Memory" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="ENE-based RGB RAM, e.g. G.Skill Trident Z5 RGB" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                        <ContentControl Content="{Binding Ram}" ContentTemplate="{StaticResource LightingBody}" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left"
                                Command="{Binding CopyMotherboardToRamCommand}" Content="Match motherboard" />
                    </StackPanel>
                </Border>

                <!-- Power -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Power" Style="{StaticResource CardTitle}" />
                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding TurnOffOnSleep}"
                                  Content="Turn lighting off while the PC is asleep" />
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding TurnOffOnShutdown}"
                                  Content="Turn lighting off when the PC shuts down" />

                        <Separator Margin="0,16" />

                        <TextBlock Text="Startup color" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,10" Style="{StaticResource Hint}"
                                   Text="ASUS only: stores motherboard and header effects for startup, and keeps onboard lighting off after shutdown. Gigabyte and direct GPU settings are applied by the service after Windows starts." />
                        <Button HorizontalAlignment="Left" Command="{Binding SaveStartupColorCommand}"
                                Content="Save startup color to motherboard" />
                    </StackPanel>
                </Border>

                <!-- App -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="App" Style="{StaticResource CardTitle}" />
                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding StartWithWindows}"
                                  Content="Start in the notification area when I sign in" />
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding CloseToTray}"
                                  Content="Keep running in the notification area when the window is closed" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}"
                                   Text="The app isn't needed for lighting to work; the service handles that. The tray icon is just a quick on/off switch." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="24,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" />
        </Border>
    </Grid>
</Window>
