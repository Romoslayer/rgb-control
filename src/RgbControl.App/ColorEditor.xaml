<UserControl x:Class="RgbControl.App.ColorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Preview" Width="72" Height="72" CornerRadius="8" VerticalAlignment="Top"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" />

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <ItemsControl x:Name="Presets">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0" Cursor="Hand"
                                ToolTip="{Binding}" Click="OnPresetClick" Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="13" Background="{Binding}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="R" Style="{StaticResource FieldLabel}" Margin="0" />
                <Slider x:Name="Red" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Red}" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" Margin="0" />

                <TextBlock Grid.Row="1" Text="G" Style="{StaticResource FieldLabel}" Margin="0" />
                <Slider x:Name="Green" Grid.Row="1" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=Green}" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" Margin="0" />

                <TextBlock Grid.Row="2" Text="B" Style="{StaticResource FieldLabel}" Margin="0" />
                <Slider x:Name="Blue" Grid.Row="2" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=Blue}" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" Margin="0" />

                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Hex" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HexBox" Width="110" MaxLength="7"
                             LostKeyboardFocus="OnHexCommit" KeyDown="OnHexKeyDown" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
